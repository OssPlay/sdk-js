{
	"name": "@ossplay/sdk",
	"version": "0.1.0",
	"description": "TypeScript/JavaScript client for OSSPlay's public consumer API",
	"license": "MIT",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OssPlay/sdk-js.git",
		"directory": "packages/sdk"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"test": "bun test"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"tsup": "^8.3.5",
		"typescript": "^5.9.3"
	}
}
