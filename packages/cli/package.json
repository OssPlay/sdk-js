{
	"name": "@ossplay/cli",
	"version": "0.1.0",
	"description": "CLI for OSSPlay's public consumer API, built on @ossplay/sdk",
	"license": "MIT",
	"type": "module",
	"bin": {
		"op": "dist/index.js",
		"ossplay": "dist/index.js"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/OssPlay/sdk-js.git",
		"directory": "packages/cli"
	},
	"scripts": {
		"build": "tsup",
		"typecheck": "tsc --noEmit",
		"lint": "biome lint .",
		"test": "bun test"
	},
	"dependencies": {
		"@ossplay/sdk": "workspace:*"
	},
	"devDependencies": {
		"@types/bun": "^1.3.14",
		"@types/node": "^22.0.0",
		"tsup": "^8.3.5",
		"typescript": "^5.9.3"
	}
}
