{
	"name": "ossplay-sdk-js",
	"private": true,
	"version": "0.0.0",
	"workspaces": [
		"packages/*"
	],
	"packageManager": "bun@1.3.14",
	"scripts": {
		"build": "bun --filter @ossplay/sdk build && bun --filter @ossplay/cli build",
		"typecheck": "bun --filter '*' typecheck",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write .",
		"test": "bun test"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.6",
		"@types/bun": "^1.3.14",
		"typescript": "^5.9.3"
	}
}
